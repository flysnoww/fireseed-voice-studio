diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,6 +10,10 @@
 # Compiler flags
 if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wextra -Wpedantic")
-    set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} -O3 -march=native")
+    if(CMAKE_CROSSCOMPILING AND CMAKE_SYSTEM_NAME STREQUAL "iOS")
+        set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} -O3")
+    else()
+        set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} -O3 -march=native")
+    endif()
     set(CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} -g -O0")
 endif()
@@ -41,7 +41,8 @@
 # Detect Metal backend availability
-if(APPLE AND EXISTS "${GGML_BUILD_DIR}/src/ggml-metal/libggml-metal.dylib")
+if(APPLE AND (EXISTS "${GGML_BUILD_DIR}/src/ggml-metal/libggml-metal.dylib"
+              OR EXISTS "${GGML_BUILD_DIR}/src/ggml-metal/libggml-metal.a"))
     set(GGML_HAS_METAL ON)
     message(STATUS "GGML Metal backend found — GPU acceleration enabled")
 else()
     set(GGML_HAS_METAL OFF)
 endif()
@@ -174,1 +174,5 @@
 endif()
+# Static C ABI for the isolated iOS spike. The product still has no renderer integration.
+add_library(qwen3tts_ios STATIC src/qwen3tts_c_api.cpp)
+target_include_directories(qwen3tts_ios PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/src)
+target_link_libraries(qwen3tts_ios PUBLIC qwen3_tts "-framework Foundation" "-lobjc")
diff --git a/src/gguf_loader.h b/src/gguf_loader.h
--- a/src/gguf_loader.h
+++ b/src/gguf_loader.h
@@ -78,1 +78,2 @@
 void release_preferred_backend(ggml_backend_t backend);
+const char * active_backend_name();
diff --git a/src/gguf_loader.cpp b/src/gguf_loader.cpp
--- a/src/gguf_loader.cpp
+++ b/src/gguf_loader.cpp
@@ -217,1 +217,7 @@
 }
+const char * active_backend_name() {
+    const auto & shared = get_shared_backend_state();
+    if (!shared.backend) return "Not loaded";
+    ggml_backend_dev_t device = ggml_backend_get_device(shared.backend);
+    return device ? ggml_backend_dev_name(device) : "Unknown";
+}
diff --git a/src/qwen3tts_c_api.h b/src/qwen3tts_c_api.h
--- a/src/qwen3tts_c_api.h
+++ b/src/qwen3tts_c_api.h
@@ -98,1 +98,3 @@
     const Qwen3TtsParams* params);
+/* Spike instrumentation: actual device selected by GGML, if loaded. */
+const char* qwen3_tts_active_backend_name(const Qwen3Tts* tts);
diff --git a/src/qwen3tts_c_api.cpp b/src/qwen3tts_c_api.cpp
--- a/src/qwen3tts_c_api.cpp
+++ b/src/qwen3tts_c_api.cpp
@@ -241,1 +241,5 @@
 }
+const char * qwen3_tts_active_backend_name(const Qwen3Tts * tts) {
+    if (!tts || !tts->engine.is_loaded()) return "Not loaded";
+    return qwen3_tts::active_backend_name();
+}
